/* app.wxss —— 全局设计规范（依据《UI视觉规范 v1.0》）
   设计语言：温暖手工风（大圆角 + 柔阴影）；配色一律走主题 token ——
   默认主题见 utils/themes.js 的 DEFAULT（当前 = 暖陶土，即项目最初那套配色） */

page {
  /* ===== 1. 配色 token =====
     ⚠️ 这里是**真兜底**，不是占位：主题变量平时由 page-meta 的 page-style 写进页面根节点
     （utils/theme-page.js 的 apply）。但万一哪个页面漏接了 page-meta、或某个基础库不认
     page-style，就必须落到**默认主题的实值**上。
     以前这里写的是自引用（--color-primary: var(--color-primary)）—— 那不是兜底：
     自引用按 CSS 规范是无效值，会让 13 个变量一起失效 ⇒ **整页没有颜色**（比"用错主题"更糟）。
     下列值与 themes.js 的默认主题（**暖陶土**）逐字一致，由 tests/guard-theme.test.js ⑩ 钉住。 */
  --color-primary: #C28E72;
  --color-primary-deep: #A9765C;
  --color-primary-soft: #F3E6DC;
  --color-primary-on: #FFFFFF;

  --cat-sage: #A7B79A;
  --cat-mist: #A9C2CB;
  --cat-butter: #E7D6A2;
  --cat-rose: #D8B2A6;
  --cat-lavender: #C3B6CE;

  /* 角色分工（V115）：默认值 = 现状（暖陶土）—— 主题声明了 roles 就由 page-style 覆盖 */
  --color-chip: #C28E72; --color-chip-on: #FFFFFF;
  --color-fab: #C28E72; --color-fab-on: #FFFFFF;
  --color-highlight: #FFFDFA; --color-highlight-on: #B7AAA0;
  --color-highlight-sub: #8A7B6D;   /* V118 点睛卡副信息（默认=暖陶土 text-2；粉帽=摩卡棕） */
  --color-ring: #C28E72;            /* V119 选中荧光描边（默认=暖陶土 primary；粉帽=樱花粉） */
  --color-num-1: #C28E72; --color-num-2: #C28E72; --color-num-3: #C28E72;
  --color-band: #FAF6F0;   /* V116 顶部固定区底色（默认=页面底；粉帽主题=樱花粉） */

  --color-bg: #FAF6F0;
  --color-surface: #FFFDFA;
  --color-surface-2: #F5EFE7;
  --color-divider: #EDE4D9;
  --color-text-1: #4A3F35;
  --color-text-2: #8A7B6D;
  --color-text-3: #B7AAA0;
  --color-mask: rgba(74, 63, 53, 0.40);
  --color-accent: #E7D6A2;

  --color-success: #8FB27E;
  --color-warning: #E0A26B; /* 低库存 / DDL≤3天 */
  --color-danger: #D9786A;  /* 超期 / 删除 / 出库拦截 */
  --color-info: #9DB8C2;

  /* ===== 2. 圆角 / 阴影 / 间距 ===== */
  --radius-card: 24rpx;
  --radius-btn: 16rpx;
  --radius-pill: 999rpx;
  --radius-inner: 16rpx;
  --shadow-card: 0 6rpx 20rpx rgba(120, 90, 60, 0.05);
  --shadow-btn: 0 4rpx 12rpx rgba(194, 142, 114, 0.25);
  --page-margin: 32rpx;
  --gap-section: 32rpx;
  --gap-card: 24rpx;
  --card-padding: 32rpx;

  /* ===== 3. 间距 token（统一规范：卡内组间=sm，卡间=md，大块间=lg） ===== */
  --space-xs: 8rpx;   /* 一行内紧挨小控件之间 */
  --space-sm: 16rpx;  /* 同一张卡片内两组内容之间 */
  --space-md: 24rpx;  /* 两张卡片之间 / 弹窗内区块之间 */
  --space-lg: 32rpx;  /* 页面大块之间 */
  --space-xl: 48rpx;  /* 页面最外上下留白 */

  /* ===== 4. 输入框高度 token ===== */
  --input-sm: 64rpx;  /* 行内紧凑：BOM 长×宽、单位切换 */
  --input-md: 80rpx;  /* 标准表单字段 */
  --input-lg: 96rpx;  /* 弹窗底部 sheet 大输入 */

  /* ===== 5. 控件高度 token ===== */
  --chip-h: 56rpx;        /* 分类筛选胶囊 */
  --unit-toggle-h: 64rpx; /* 单位切换 m/cm、m²/cm² */
  --btn-h: 88rpx;         /* 主按钮 */
  --btn-sm-h: 64rpx;      /* 次/小按钮 */


  --font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;

  background: var(--color-bg);
  color: var(--color-text-1);
  font-family: var(--font-family);
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button, input, textarea, scroll-view, image, navigator {
  box-sizing: border-box;
}

/* ===== 字体阶梯 ===== */
.t-h1 { font-size: 44rpx; font-weight: 600; line-height: 1.4; color: var(--color-text-1); }
.t-h2 { font-size: 34rpx; font-weight: 600; line-height: 1.4; color: var(--color-text-1); }
.t-h3 { font-size: 30rpx; font-weight: 600; line-height: 1.4; color: var(--color-text-1); }
.t-body { font-size: 28rpx; font-weight: 400; line-height: 1.6; color: var(--color-text-1); }
.t-strong { font-size: 28rpx; font-weight: 600; line-height: 1.6; color: var(--color-text-1); }
.t-caption { font-size: 24rpx; font-weight: 400; line-height: 1.5; color: var(--color-text-2); }
.t-min { font-size: 20rpx; font-weight: 400; line-height: 1.4; color: var(--color-text-3); }

/* ===== 布局骨架 ===== */
.page-wrap { padding: var(--page-margin); padding-bottom: 160rpx; }

/* V116：顶部固定区（看板 / 物料库 / 作品集 / 我的 四页共用）
   用户 2026-10-05：「圈出的部分固定，上下滑动时固定在原地，只有下面的列表能滑」
   ＋「固定住的部分背景是粉色，再往下就是奶黄色」。
   ⚠️ 做法沿用 V105 验证过的『fixed + 等高等位』：固定带脱离文档流，靠 .pin-band-ph 占位；
      高度由 JS 量（内容会变：作品集切分段时多一行、主题不同高度也不同）。
   ⚠️ z-index 40 是夹缝里唯一的空位：高于页面内容、低于弹层（mask=100）与底栏（tabBar=200）。
   ⚠️ 底色走角色 --color-band：粉帽=樱花粉；没声明这套的主题=页面底（视觉零变化）。 */
.pin-band {
  position: fixed; left: 0; right: 0; top: 0;
  z-index: 40;
  background: var(--color-band);
  /* ⚠️ V116a/V116b：**下边距单独一档**，而且必须与下面「带页的页面根节点」的
     顶部内边距**相等** —— 这条界线（粉/奶黄交界）才会落在"带内最后一行"与
     "带下第一行"两行字的**正中间**（用户 2026-10-05：「分界线应该在两行字的中间，
     而不是紧挨着下面那行字」）。两半相加仍是原来那一档 24rpx ⇒ 内容位置不变。
     不许写成四边同值 —— 那样带底空白会与页面顶部内边距叠成两份（缝隙过宽）。 */
  padding: var(--page-margin) var(--page-margin) 12rpx;
  box-sizing: border-box;
}
/* V117：带页 = 整页铺 --color-band（面板外围露出的色）+ 内容装进奶黄圆角面板。
   ⇒ 页面的内边距全部归零、改由面板承担（面板贴边 ⇒ 两侧不留细条）。
   --color-band 在其它三套主题里就等于页面底 ⇒ 零视觉变化。 */
.page-wrap.pin-page {
  padding: 0;
  min-height: 100vh;
  background: var(--color-band);
}
/* V117：奶黄圆角面板 —— 从分界线起，包住下面的**全部内容**（用户 2026-10-05：
   「奶黄圆角面板（22px 顶弧）包住『原料资产』往下的全部内容，底部毛玻璃栏不变」）。
   · 顶边两角 44rpx（= 用户口述的 22px × 2）圆弧；下边不圆、一直铺到屏幕底
     （min-height 由页面内联给 —— 值依赖量出来的带高）。
   · 面板自己承担左右页面边距（贴边、不露细条），并接替原来页面底部 160rpx 的避让留白。
   ⚠️ 不许加 overflow / transform / filter：面板里装着 fixed 定位的弹层，
      会被裁掉或失去 fixed 语义（守卫 ⑧ 盯着这条）。
   ⚠️ 底色 = --color-bg（现在就是页面底）⇒ 其它三套主题零视觉变化。 */
.content-panel {
  padding: 12rpx var(--page-margin) 160rpx;
  background: var(--color-bg);
  border-radius: 44rpx 44rpx 0 0;
  box-sizing: border-box;
}
/* V116a：带内**最后一块**控件的下边距归零 —— 那份"到下一块"的间距已由带的下内边距统一承担，
   各自留一份就叠成两份了。四页的最后一块分别是：看板 .topbar / 物料库 .mc-scroll /
   作品集 .summary（计数行 —— ⚠️ 不是 .cat-sub，它下面还有计数行，归零它就抹掉了带内间距）/ 我的 .card */
.pin-band .topbar, .pin-band .mc-scroll, .pin-band .summary, .pin-band .card {
  margin-bottom: 0;
}
.pin-band-ph { width: 100%; }
.section { margin-bottom: var(--gap-section); }
.section-title { font-size: 30rpx; font-weight: 600; color: var(--color-text-1); margin-bottom: 20rpx; }
.section-title .sub { font-size: 24rpx; font-weight: 400; color: var(--color-text-3); margin-left: 12rpx; }

/* ===== 通用卡片 ===== */
.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--card-padding);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--gap-card);
}
.card.flat { box-shadow: none; border: 1rpx solid var(--color-divider); }

/* ===== 统一列表卡片（灵感 / 想做 / 物料库 / 作品集列表共用） ===== */
.std-card {
  display: flex; align-items: center; box-sizing: border-box;
  height: 160rpx; padding: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.std-thumb {
  width: 120rpx; height: 120rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-inner);
  overflow: hidden;
  background: var(--color-surface-2);
}
.std-thumb image { width: 100%; height: 100%; display: block; }
/* ===== 无图占位块（全项目统一） =====
   底色 background 与首字墨色 color 一律由内联 style 注入，取值见 utils/palette.js：
   底色 = 所属大类/品类配色，墨色 = 同色系深调半透明（首字淡印效果）。
   这里只负责居中与字号，各页面可覆盖 font-size 以适配自己的缩略图尺寸。 */
.ph-fill {
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 600; line-height: 1;
}
.std-body {
  flex: 1; min-width: 0;
  height: 120rpx; margin-left: 20rpx;
  display: flex; flex-direction: column; justify-content: center;
  overflow: hidden;
}
.std-title {
  font-size: 30rpx; font-weight: 600; line-height: 1.2;
  color: var(--color-text-1);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.std-sub {
  font-size: 24rpx; color: var(--color-text-2); line-height: 1.3;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  margin-top: 8rpx;
}
.std-sub-line {
  font-size: 24rpx; color: var(--color-text-2); line-height: 1.3;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.std-sub-line.muted { color: var(--color-text-3); font-size: 22rpx; }
.std-tag { flex: none; margin-left: 16rpx; }

/* ===== 按钮 ===== */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: var(--radius-btn);
  font-weight: 600; border: none; line-height: 1;
  padding: 0 40rpx;
}
.btn::after { border: none; }
.btn-large { height: 88rpx; font-size: 30rpx; }
.btn-medium { height: 72rpx; font-size: 28rpx; }
.btn-small { height: 56rpx; font-size: 24rpx; padding: 0 32rpx; }
.btn-primary { background: var(--color-primary); color: var(--color-primary-on); box-shadow: var(--shadow-btn); }
.btn-primary.btn-hover { background: var(--color-primary-deep); }
.btn-secondary { background: var(--color-surface-2); color: var(--color-text-1); }
.btn-text { background: transparent; color: var(--color-primary); padding: 0 16rpx; }
.btn-danger { background: #FBEAE6; color: var(--color-danger); }
/* 幽灵按钮（V137 补登记）：**无底无描边**，用于"次要 / 放弃"这类动作
   （灵感编辑页与想做编辑页的「返回」、损耗页换新面板的「取消」）。
   ⚠️ 它一直是**约定俗成但没被定义**的类 —— 4 处都在用、只有「设置 · 清单编辑器」自己定义过；
   本页补这一行**不改变任何页面的观感**（`.btn` 本来就没有背景色），
   目的是把"这个类是什么"写进唯一权威处，免得下一个人以为它是个笔误而随手删掉。 */
.btn-ghost { background: transparent; }
.btn-block { display: flex; width: 100%; }
.btn[disabled] { background: var(--color-surface-2); color: var(--color-text-3); box-shadow: none; }

/* 详情页操作行（编辑 / 删除 等多按钮）：两列网格均匀分布，自动换行，全局统一标准 */
.ops { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
.ops .btn { flex: 1 1 calc(50% - var(--space-sm)); min-width: 0; }

/* ===== 标签 / 角标 ===== */
.tag {
  display: inline-flex; align-items: center; height: 40rpx; padding: 0 16rpx;
  border-radius: var(--radius-pill); font-size: 20rpx; color: var(--color-text-2);
  background: var(--color-surface-2);
}
.tag-soft { background: var(--color-primary-soft); color: var(--color-primary-deep); }
.tag-success { background: rgba(143, 178, 126, 0.18); color: var(--color-success); }
.badge-warning { background: rgba(224, 162, 107, 0.16); color: var(--color-warning); }
.badge-danger { background: rgba(217, 120, 106, 0.16); color: var(--color-danger); }
.badge-success { background: rgba(143, 178, 126, 0.18); color: var(--color-success); }

/* 类别色小圆点 */
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; display: inline-block; }

/* ===== 表单字段 ===== */
.field { margin-bottom: 28rpx; }
.field-label { font-size: 26rpx; color: var(--color-text-2); margin-bottom: 12rpx; }
.field-label .req { color: var(--color-danger); margin-left: 6rpx; }
.field-control {
  background: var(--color-surface-2); border-radius: var(--radius-inner);
  min-height: 80rpx; line-height: 40rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; color: var(--color-text-1);
}
.input { width: 100%; }
textarea.field-control, textarea.input { width: 100%; min-height: 160rpx; line-height: 1.5; }
/* 可点击的 picker 触发区：带下拉箭头 */
.picker-trigger {
  position: relative;
  padding-right: 56rpx;
}
.picker-trigger::after {
  content: '';
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--color-text-3);
  border-right: 3rpx solid var(--color-text-3);
  transform: translateY(-65%) rotate(135deg);
}
/* 页面级 .range-picker 的 padding 简写会覆盖上面 padding-right，此处用更高特异性保住箭头留白 */
.range-picker.picker-trigger { padding-right: 56rpx; }

/* 列表行 */
.list-row {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 120rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-divider);
}
.list-row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 30rpx; color: var(--color-text-1); font-weight: 500; }
.row-sub { font-size: 24rpx; color: var(--color-text-2); margin-top: 6rpx; }
.url-sub { color: var(--color-primary-deep); word-break: break-all; }
.row-arrow { color: var(--color-text-3); font-size: 32rpx; margin-left: 16rpx; }

/* 分段控件 */
.segment { display: flex; background: var(--color-surface-2); border-radius: var(--radius-pill); padding: 6rpx; }
.segment-item { flex: 1; text-align: center; height: 64rpx; line-height: 64rpx; font-size: 26rpx; color: var(--color-text-2); border-radius: var(--radius-pill); }
.segment-item.active { background: var(--color-surface); color: var(--color-primary-deep); font-weight: 600; box-shadow: var(--shadow-card); }

/* 安全区 */
/* V141：所有"贴到屏幕底"的留白都要**同时**避开安全区与底部导航栏：
   自定义 tabBar 是独立组件树、永远画在页面之上（z-index 抬不过它）⇒ 只能留白避开。
   `--tabbar-h` 由 utils/theme-page.js 按"这一页有没有 tabBar"注入（tab 页 110rpx / 其它 0px）
   ⇒ 非 tab 页的视觉**一点没变**，tab 页自动让开。守卫 tests/guard-tabbar-overlap.test.js 盯着。 */
.safe-bottom { height: calc(34rpx + env(safe-area-inset-bottom) + var(--tabbar-h, 0px)); }
/* 底部操作栏：按钮平均分布（flex:1 等分整行），全局统一标准 */
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; background: var(--color-surface);
  display: flex; align-items: center; gap: var(--space-sm);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom) + var(--tabbar-h, 0px));
  box-shadow: 0 -6rpx 20rpx rgba(120, 90, 60, 0.05); z-index: 50;
}
.bottom-bar .btn { flex: 1; min-width: 0; }

/* 浮动操作按钮 FAB */
/* ⚠️ V141：这里**故意不加** --tabbar-h —— 140rpx 本来就大于 tabBar 的 110rpx（还留 30rpx 余量），
   而它当前只用在非 tab 页（灵感 / 想做 / 排单 / 损耗）。若哪天挪进 tab 页也仍然够，
   所以守卫把它登记为「已达标」。 */
.fab {
  position: fixed; right: 40rpx; bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--color-primary);
  color: var(--color-primary-on); display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; box-shadow: var(--shadow-btn); z-index: 60;
}

/* 文本颜色辅助 */
.text-success { color: var(--color-success); }
.text-danger { color: var(--color-danger); }
.text-warning { color: var(--color-warning); }
.text-primary { color: var(--color-primary-deep); }
.text-2 { color: var(--color-text-2); }
.text-3 { color: var(--color-text-3); }
.text-mono { font-variant-numeric: tabular-nums; }

/* 分隔 */
.hr { height: 1rpx; background: var(--color-divider); margin: 24rpx 0; }

/* ===== 通用弹窗：遮罩 + 底部面板（全局，所有页面共用） ===== */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: var(--color-mask);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet, .quick-sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: 28rpx 28rpx 0 0;
  /* V141：+ var(--tabbar-h, 0px) —— 贴底弹窗的按钮不许被底部导航栏压住（见 .safe-bottom 上方说明）。
     当前用它的都是非 tab 页 ⇒ 0px、零变化；将来 tab 页用上就自动让开。 */
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom) + var(--tabbar-h, 0px));
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
  animation: sheetUp 0.26s ease;
}
@keyframes sheetUp {
  from { transform: translateY(100%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
.sheet-title {
  font-size: 32rpx; font-weight: 600; color: var(--color-text-1);
  margin-bottom: 24rpx;
}
.sheet-ops { margin-top: 24rpx; }

/* ===== 顶部单行栏：手作空间切换 =====
   ⚠️ 2026-10-04：现在**只有看板页**用它 —— 物料库 / 作品集顶部的同一排胶囊已删
   （三个 tab 页都挂一排太重复，切换收敛到看板一处）。
   这套样式留着是因为看板仍需要；别再往别的页面加，除非先想清楚"为什么又要在那儿放一次"。 */
.topbar {
  display: flex; align-items: center;
  height: 72rpx;                       /* 单行、紧凑，不占高 */
  margin-bottom: 24rpx;
}
/* 手作空间横向滚轮：内容宽度优先，溢出（多分类）才滚动 */
.space-scroll {
  flex: 0 1 auto;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
}
.space-scroll::-webkit-scrollbar { display: none; }
.space-pills { display: inline-flex; align-items: center; gap: 12rpx; }
/* 紧凑小巧切换控件：非宽大臃肿长胶囊 */
.space-pill {
  flex: none;
  height: 52rpx; line-height: 52rpx; padding: 0 24rpx;
  background: var(--color-surface-2); color: var(--color-text-2);
  border-radius: var(--radius-pill); font-size: 26rpx;
  transition: background 0.15s ease, color 0.15s ease;
}
.space-pill.on {
  /* V115：选中胶囊走**角色**而不是 primary —— 姜饼粉帽的设计稿里它是摩卡棕实底+米黄字
     （用户原话「手作空间按钮…是棕色的」）；其它主题 roles 默认=primary，外观不变。 */
  background: var(--color-chip); color: var(--color-chip-on); font-weight: 600; box-shadow: var(--shadow-btn);
}
.space-pill:active { opacity: 0.9; }

/* 操作栏右侧文字入口（批量入库 / 分类管理 等） */
.toolbar-actions {
  display: flex; justify-content: flex-end; gap: 28rpx; margin-bottom: 24rpx;
}
.toolbar-actions .link { font-size: 26rpx; color: var(--color-band-ink, var(--color-primary)); }
.toolbar-actions .link:active { opacity: 0.6; }
