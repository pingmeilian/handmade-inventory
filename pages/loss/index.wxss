/* pages/loss/index.wxss —— 损耗列表 */
.top-loss {
  margin: 20rpx 0 12rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-deep) 100%);
  color: var(--color-primary-on);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.top-loss-val { font-size: 32rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.top-loss-break { font-size: 22rpx; opacity: 0.92; margin-top: 8rpx; }

/* 其它支出（V131）：一条轻量合计行 —— 不用 .top-loss 那张主色渐变卡（页面级已有一张，两张太重） */
.other-total {
  margin: 20rpx 0 12rpx; padding: 20rpx 24rpx;
  background: var(--color-surface-2); border-radius: var(--radius-card);
  font-size: 26rpx; color: var(--color-text-1); font-variant-numeric: tabular-nums;
}

/* 同 seg 内状态分组导航 —— 与顶部 segment 一致的横排胶囊布局 */
.group-nav {
  display: flex;
  background: var(--color-surface-2);
  border-radius: var(--radius-pill);
  padding: 6rpx;
  margin: 24rpx 0 14rpx;
  gap: 6rpx;
}
.group-pill {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-2);
  padding: 14rpx 0;
  border-radius: var(--radius-pill);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.group-pill .gc {
  font-size: 20rpx;
  color: var(--color-text-3);
  margin-left: 6rpx;
}
.group-pill.active {
  background: var(--color-surface);
  color: var(--color-primary-deep);
  font-weight: 600;
  box-shadow: var(--shadow-card);
}
.group-pill.active .gc { color: var(--color-primary-deep); opacity: 0.7; }

.loss-card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 20rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: var(--gap-card);
}
.loss-card { display: flex; flex-wrap: wrap; align-items: flex-start; }
.loss-main { flex: 1; min-width: 0; }
.loss-right { margin-left: 16rpx; }
.loss-name { font-size: 30rpx; font-weight: 600; color: var(--color-text-1); }
.loss-spec { font-size: 24rpx; font-weight: 400; color: var(--color-text-2); }
.loss-sub { font-size: 24rpx; color: var(--color-text-2); margin-top: 8rpx; }
.loss-dates { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; }
.loss-dates .d { font-size: 20rpx; color: var(--color-text-3); }

.repair-list { margin-top: 14rpx; border-top: 1rpx dashed var(--color-divider); padding-top: 12rpx; }
.repair-row { display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx 14rpx; padding: 6rpx 0; font-size: 22rpx; }
.rp-date { color: var(--color-text-3); font-variant-numeric: tabular-nums; }
.rp-fee { color: var(--color-text-1); font-weight: 600; font-variant-numeric: tabular-nums; }
.rp-note { color: var(--color-text-2); flex: 1; min-width: 120rpx; }
.rp-acts { display: flex; gap: 20rpx; }
.rp-edit { color: var(--color-primary-deep); }
.rp-del { color: var(--color-danger); }

.loss-actions {
  width: 100%;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-divider);
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.act {
  font-size: 24rpx;
  color: var(--color-text-2);
  background: var(--color-surface-2);
  border-radius: var(--radius-pill);
  padding: 10rpx 28rpx;
  line-height: 1.2;
}
.act-primary { background: var(--color-primary); color: var(--color-primary-on); }
.act-danger { background: #FBEAE6; color: var(--color-danger); }

/* 换新弹层 */
.sheet {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: var(--color-surface);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(0,0,0,0.12);
}
.sheet-title { font-size: 30rpx; font-weight: 700; color: var(--color-text-1); }
.sheet-tip { font-size: 22rpx; color: var(--color-text-3); margin-top: 8rpx; margin-bottom: 8rpx; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sheet-actions .btn { flex: 1; }

/* 卡片详情展开（日期 / 维修） */
.detail-toggle { font-size: 22rpx; color: var(--color-primary-deep); margin-top: 10rpx; }
.loss-detail { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed var(--color-divider); }
.repair-block { margin-top: 10rpx; }
.repair-toggle { font-size: 22rpx; color: var(--color-text-2); padding: 6rpx 0; }

/* 更多操作按钮 */
.act-more { background: var(--color-surface-2); color: var(--color-primary-deep); border: 1rpx solid var(--color-primary); font-weight: 500; }

/* 更多操作菜单弹层 */
.menu-act { padding: 28rpx 0; text-align: center; font-size: 30rpx; color: var(--color-text-1); border-bottom: 1rpx solid var(--color-divider); }
.menu-act.danger { color: var(--color-danger); }
.menu-cancel { padding: 28rpx 0; text-align: center; font-size: 30rpx; color: var(--color-text-2); margin-top: 12rpx; }
