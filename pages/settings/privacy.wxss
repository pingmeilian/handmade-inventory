/* pages/settings/privacy.wxss —— 复用 about 的基础样式变量 */
.card { padding: 32rpx; background: var(--color-surface); border-radius: var(--radius-card); box-shadow: var(--shadow-card); margin-bottom: 24rpx; }
.about-title { font-size: 34rpx; font-weight: 600; color: var(--color-text-1); }
.about-ver { font-size: 24rpx; color: var(--color-text-3); margin-top: 10rpx; }
.hr { height: 1rpx; background: var(--color-divider); margin: 24rpx 0; }
.sec { margin-bottom: 28rpx; }
.sec-t { font-size: 28rpx; font-weight: 600; color: var(--color-primary-deep); display: block; margin-bottom: 12rpx; }
.t-body { font-size: 26rpx; color: var(--color-text-2); line-height: 1.7; }
.menu-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; }
.agree-row { background: var(--color-primary-soft); border-radius: var(--radius-inner); padding: 0 24rpx; }
.row-title { font-size: 28rpx; color: var(--color-text-1); }
.row-arrow { color: var(--color-text-3); font-size: 36rpx; }
.tip { text-align: center; margin-top: 16rpx; }
