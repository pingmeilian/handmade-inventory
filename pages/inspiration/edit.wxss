/* pages/inspiration/edit.wxss */
.field-static { font-size: 28rpx; color: var(--color-text-2); padding: 12rpx 0; }
.field-hint { font-size: 22rpx; color: var(--color-text-3); margin-top: 12rpx; }

.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 8rpx; }
.photo { position: relative; width: 160rpx; height: 160rpx; border-radius: 16rpx; overflow: hidden; background: var(--color-surface-2); }
.photo-img { width: 100%; height: 100%; }
.photo-del {
  position: absolute; top: 4rpx; right: 4rpx; width: 36rpx; height: 36rpx;
  background: rgba(0,0,0,0.45); color: #fff; border-radius: 50%;
  font-size: 28rpx; line-height: 36rpx; text-align: center;
}
.photo-add {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 2rpx dashed var(--color-primary); box-sizing: border-box;
}
.add-plus { font-size: 48rpx; color: var(--color-primary); line-height: 1; }
.add-tip { font-size: 20rpx; color: var(--color-text-3); margin-top: 4rpx; }
