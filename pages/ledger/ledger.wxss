/* pages/ledger/ledger.wxss —— 累计总账（V131 建页 / V132 重排 / V133 调整 / V135 修留白叠加） */
/* ⚠️⚠️ V135 根因：本页最外层是 `<view class="page-wrap">`，**没有 pin-page 类** ——
   而全局 `.page-wrap` 自带 `padding: 32rpx`（app.wxss:102），又叠上 `.content-panel` 的留白
   ⇒ 实际左右留白 = 32 + 24 = **56rpx**，比看板 / 我的等"带页"（它们用 `.page-wrap.pin-page`
   把这一层归零，只剩 content-panel 的 32rpx）**宽了近一倍**。
   用户看得很准：「这个页面两边的留白和首页的留白一样窄」。
   ⇒ 修法是**去掉一层**：把 `.page-wrap` 的 padding 归零（与带页同做法），
     左右留白只由 `.content-panel` 出，取全局 `--page-margin`（32rpx）——与首页完全一致。
     （上一版用 `--ledger-margin: 24rpx` 只是把叠加后的 56rpx 调成 56→56…治标；现已删掉该变量。） */
.page-wrap { padding: 0; min-height: 100vh; background: var(--color-bg); }
.content-panel { padding: 24rpx var(--page-margin) 40rpx; }

/* 头部：左标题（+ 空间名） / 右区间
   ⚠️ V136：标题里多了空间名 ⇒ 两侧都上 nowrap，避免长空间名把区间挤折行。
   （这页对"折行"敏感是 V133 的老教训：金额一大就把标题挤成两行、两边行错位。） */
.ledger-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20rpx; }
.ledger-title { font-size: 38rpx; font-weight: 700; color: var(--color-text-1); white-space: nowrap; }
/* 空间名：像副标题 —— 小一号、用次级文字色，别抢「累计总账」的视线 */
.ledger-space { font-size: 24rpx; font-weight: 400; color: var(--color-text-3); margin-left: 8rpx; }
.ledger-range { font-size: 22rpx; color: var(--color-text-3); white-space: nowrap; flex: none; }

/* 两个大数字 */
.hero { display: flex; gap: 20rpx; }
.hero-col {
  flex: 1; min-width: 0; padding: 24rpx;
  background: var(--color-surface); border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.hero-k { font-size: 22rpx; color: var(--color-text-3); }
.hero-v {
  font-size: 46rpx; font-weight: 700; color: var(--color-text-1);
  font-variant-numeric: tabular-nums; margin-top: 8rpx; white-space: nowrap;
}
.hero-col-in .hero-v { color: var(--color-primary-deep); }

.sec {
  margin-top: 28rpx; padding: 20rpx 20rpx 8rpx; background: var(--color-surface);
  border-radius: var(--radius-card); box-shadow: var(--shadow-card);
}
/* 收入卡标题行：左标题 + 右合计（它只有两行明细、金额也短，不会挤，保持原样） */
.sec-title {
  display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx;
  font-size: 28rpx; font-weight: 600; color: var(--color-text-1);
}
.col-total {
  font-size: 22rpx; font-weight: 700; color: var(--color-primary-deep);
  font-variant-numeric: tabular-nums; white-space: nowrap; flex: none;
}
/* ⚠️ V133：口径标题行**只放文字、不再夹金额**（真机上金额一大就把标题挤成两行、
   A 卡内容被推低 ⇒ 两边行错位）。nowrap 是兜底，防以后又有人往里塞东西。 */
.col-head {
  font-size: 22rpx; font-weight: 600; color: var(--color-text-1);
  padding-bottom: 10rpx; border-bottom: 1rpx solid var(--color-divider);
  white-space: nowrap;
}

/* 明细行
   ⚠️ nowrap 是硬约束，不是优化：A、B 并排后每张卡只有半行宽，
      不禁掉换行就会「挤一挤就断成两行」（本页初版的原始 bug）。 */
.row {
  display: flex; align-items: center; justify-content: space-between; gap: 8rpx;
  padding: 14rpx 0; border-bottom: 1rpx solid var(--color-divider);
}
.row:last-child { border-bottom: none; }
.row-l { font-size: 22rpx; color: var(--color-text-1); white-space: nowrap; }
.row-v {
  font-size: 22rpx; color: var(--color-text-1);
  font-variant-numeric: tabular-nums; white-space: nowrap; flex: none;
}
.row-ph .row-l, .row-ph .row-v { color: var(--color-text-3); }   /* B 侧空位占位行：灰、显示「—」 */
.row-link .row-l { color: var(--color-primary-deep); }
/* 合计行（V133 起放在卡片**最下边一行**）：padding 与明细行一致 ⇒ 两卡的合计仍在同一横线 */
.row-total .row-l, .row-total .row-v { font-weight: 700; color: var(--color-primary-deep); }

/* 消费：A、B 并排两张卡 —— 各占半行；两边行高一致，空位用占位行补齐 ⇒ 合计落在同一横线 */
.cols { display: flex; gap: 16rpx; margin-top: 28rpx; }
.col {
  flex: 1; min-width: 0; padding: 20rpx;
  background: var(--color-surface); border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.safe-bottom { height: 40rpx; }
