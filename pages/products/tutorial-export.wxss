/* pages/products/tutorial-export.wxss */
.page-wrap { padding: 24rpx; }
.exp-head { padding: 8rpx 8rpx 20rpx; }
.exp-title { font-size: 36rpx; font-weight: 700; color: var(--color-text-1); word-break: break-all; overflow-wrap: anywhere; }
.exp-sub { font-size: 24rpx; color: var(--color-text-3); margin-top: 6rpx; word-break: break-all; overflow-wrap: anywhere; }

.tut-preview { margin-bottom: 20rpx; }
.pv-step { padding: 20rpx 0; border-bottom: 1rpx solid var(--color-divider); }
.pv-step:last-child { border-bottom: none; }
.pv-step-head { display: flex; align-items: center; gap: 14rpx; }
.pv-num { flex: none; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; background: var(--color-primary-deep); color: var(--color-primary-on); border-radius: 999rpx; font-size: 24rpx; }
/* 超长文本自动换行：break-all + anywhere 双保险，中英文/URL 都不会溢出屏幕 */
.pv-step-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; color: var(--color-text-1); word-break: break-all; overflow-wrap: anywhere; }
.pv-body { font-size: 28rpx; color: var(--color-text-2); line-height: 1.6; margin-top: 10rpx; word-break: break-all; word-wrap: break-word; overflow-wrap: break-word; white-space: pre-wrap; }
.pv-imgs { display: flex; flex-direction: column; gap: 12rpx; margin-top: 12rpx; }
/* 预览页：左图右文一行 */
.pv-img-row { display: flex; align-items: stretch; gap: 12rpx; }
.pv-img { flex: none; width: 200rpx; height: 200rpx; border-radius: var(--radius-inner); background: var(--color-divider); }
.pv-remark {
  flex: 1; min-width: 0;
  font-size: 26rpx; color: var(--color-text-2); line-height: 1.5;
  word-break: break-all; word-wrap: break-word; overflow-wrap: break-word;
}
.pv-mats { font-size: 24rpx; color: var(--color-text-3); margin-top: 10rpx; word-break: break-all; overflow-wrap: anywhere; }

/* 自定义全屏图片预览 */
.img-preview-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.92); z-index: 1000;
  display: flex; flex-direction: column;
}
.img-preview-close {
  position: absolute; top: 64rpx; right: 24rpx;
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  color: #fff; font-size: 32rpx; z-index: 1002;
}
.img-preview-swiper { flex: 1; width: 100%; }
.img-preview-item {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 100%;
}
.img-preview-img { width: 100%; height: 100%; display: block; }
.img-preview-caption-wrap {
  padding: 24rpx 32rpx 64rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0));
}
.img-preview-caption {
  font-size: 28rpx; color: #fff; line-height: 1.5;
  word-break: break-all; word-wrap: break-word;
}
.img-preview-counter {
  display: block; margin-top: 12rpx;
  font-size: 24rpx; color: rgba(255,255,255,0.6);
}

.exp-actions { margin-top: 8rpx; }
.exp-btn {
  margin-top: 16rpx; padding: 26rpx 24rpx; border-radius: var(--radius-inner);
  background: var(--color-surface-2); color: var(--color-text-1); font-size: 28rpx; font-weight: 500;
  text-align: center;
}
.exp-btn:active { background: var(--color-primary-soft); }

/* 离屏画布：移出可视区域但保留节点 */
.exp-canvas { position: fixed; left: -3000rpx; top: 0; width: 750rpx; height: 1000rpx; }

.empty-tip { text-align: center; color: var(--color-text-3); font-size: 28rpx; padding: 120rpx 0; }
