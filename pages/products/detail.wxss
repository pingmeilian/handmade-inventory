/* pages/products/detail.wxss —— 成品详情 */

/* 照片 */
.photo-card { padding: 24rpx; }
.photo-scroll { white-space: nowrap; }
.photo-row { display: inline-flex; gap: 16rpx; }
.photo-detail { width: 200rpx; height: 200rpx; border-radius: var(--radius-inner); }

.head-top { display: flex; align-items: center; justify-content: space-between; }
.head-name { font-size: 36rpx; font-weight: 600; color: var(--color-text-1); }
.head-sub { font-size: 24rpx; color: var(--color-text-2); margin-top: 10rpx; }
.head-price { font-size: 24rpx; color: var(--color-text-1); margin-top: 16rpx; font-variant-numeric: tabular-nums; }

.cost-line { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid var(--color-divider); }
.cost-line:last-child { border-bottom: none; }
.cost-line.strong { font-weight: 600; }
.cost-line .mono { font-size: 28rpx; color: var(--color-text-1); font-variant-numeric: tabular-nums; }
/* 损耗分摊参考：子项缩进、弱化 */
.cost-line.sub-line { padding-left: 24rpx; }
.cost-line.sub-line text:first-child { color: var(--color-text-2); font-size: 26rpx; }

.bom-line { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-divider); }
.bom-line:last-child { border-bottom: none; }
.bom-name { flex: 1; font-size: 28rpx; color: var(--color-text-1); }
.bom-spec { font-size: 22rpx; color: var(--color-text-3); }
.bom-cost { font-size: 26rpx; color: var(--color-text-1); font-weight: 500; font-variant-numeric: tabular-nums; }

.tut-title { font-size: 30rpx; font-weight: 600; color: var(--color-text-1); margin-bottom: 16rpx; }
.tut-step { display: flex; align-items: flex-start; gap: 16rpx; padding: 12rpx 0; }
.tut-num { flex: none; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary-deep); font-size: 24rpx; font-weight: 600; }
.tut-text { flex: 1; font-size: 28rpx; color: var(--color-text-1); line-height: 1.6; }

.sale-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--color-divider); }
.sale-row:last-child { border-bottom: none; }
.sale-q { font-size: 26rpx; color: var(--color-text-2); }
.sale-p { font-size: 26rpx; color: var(--color-text-1); }
.sale-d { font-size: 22rpx; color: var(--color-text-3); flex: 1; }
.sale-a { font-size: 26rpx; color: var(--color-primary-deep); font-weight: 600; font-variant-numeric: tabular-nums; }
.sale-add { margin-top: 16rpx; }
.sale-del { font-size: 24rpx; color: var(--color-danger); margin-left: 8rpx; }

.tut-gen { margin-top: 22rpx; }

/* 离线画布容器：移出可视区域，仅用于导出图片 */
.card-canvas-wrap { position: fixed; left: -9999px; top: 0; }
.card-canvas { display: block; }

.ops { display: flex; gap: 16rpx; margin-bottom: 16rpx; }

.mask { position: fixed; inset: 0; background: var(--color-mask); z-index: 100; display: flex; align-items: flex-end; }
.mask.mask-center { align-items: center; justify-content: center; }
.sheet { width: 100%; background: var(--color-surface); border-radius: 32rpx 32rpx 0 0; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.sheet.sheet-center { width: 84%; max-width: 620rpx; border-radius: var(--radius-card); padding: 40rpx 32rpx; margin-bottom: 20vh; box-sizing: border-box; }
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: var(--color-text-1); }
/* 弹窗输入框：加高 + 大字号，看得清（height=line-height 保证文字垂直居中） */
.sheet .field-control {
  min-height: 96rpx; display: flex; align-items: center;
  font-size: 30rpx; box-sizing: border-box;
}
.sheet .field-control.input {
  height: var(--input-lg); line-height: 96rpx; padding: 0 24rpx;
  font-size: 32rpx; border-radius: var(--radius-inner);
}
.sheet-ops { display: flex; gap: 20rpx; margin-top: 28rpx; }
.sheet-ops .btn { flex: 1; }

/* 可折叠卡片（成本与利润 / 损耗分摊 → 二级面板） */
.collapsible { padding-top: 4rpx; padding-bottom: 4rpx; }
.cs-head { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 4rpx; }
.cs-title { font-size: 30rpx; font-weight: 600; color: var(--color-text-1); }
.cs-sum { flex: 1; font-size: 24rpx; color: var(--color-text-2); text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.chev { font-size: 38rpx; color: var(--color-text-3); line-height: 1; }

/* 二级面板明细行 */
.detail-sheet { max-height: 80vh; display: flex; flex-direction: column; }
.sheet-body { flex: 1; overflow-y: auto; margin: 4rpx 0; }
.sheet-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 4rpx; border-bottom: 1rpx solid var(--color-divider); }
.sheet-row:last-child { border-bottom: none; }
.sheet-row .mono { font-size: 30rpx; color: var(--color-text-1); font-variant-numeric: tabular-nums; }
.sheet-row.strong { font-weight: 600; }
.sheet-row.strong .mono { color: var(--color-primary-deep); }
.sheet-row.sub { padding-left: 24rpx; }
.sheet-row.sub text:first-child { color: var(--color-text-2); font-size: 26rpx; }
.sheet-cap { padding-top: 16rpx; }

/* 盘库面板 */
.stocktake-tip { font-size: 22rpx; color: var(--color-text-3); margin: 4rpx 0 18rpx; line-height: 1.4; }
.stk-preview {
  margin: 6rpx 0 4rpx; padding: 16rpx 18rpx;
  font-size: 24rpx; color: var(--color-primary-deep);
  background: var(--color-primary-soft); border-radius: var(--radius-inner); line-height: 1.5;
}

/* 记录售出：单价 / 总价 切换（instances 页用的是同一套类名与样式，改动请同步） */
.sell-head { display: flex; align-items: center; justify-content: space-between; }
.sell-seg {
  display: flex; gap: 4rpx; padding: 4rpx;
  background: var(--color-surface-2); border-radius: var(--radius-pill);
}
.sell-seg-item {
  padding: 8rpx 26rpx; border-radius: var(--radius-pill);
  font-size: 24rpx; color: var(--color-text-2);
}
.sell-seg-item.on { background: var(--color-primary-deep); color: var(--color-primary-on); font-weight: 500; }
.sell-preview { margin-top: 10rpx; font-size: 22rpx; color: var(--color-text-3); text-align: right; }
/* 卖给谁（2026-09-27 D76）：留空提示 + 从关联排单一键填入的候选 */
.sell-opt { font-size: 22rpx; color: var(--color-text-3); font-weight: 400; }
.sell-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.sell-chip { font-size: 22rpx; color: var(--color-text-2); background: var(--color-surface-2); border-radius: var(--radius-pill); padding: 6rpx 18rpx; }
