/* pages/want/detail.wxss */
.page-wrap { padding: 24rpx; box-sizing: border-box; }

.d-title { font-size: 38rpx; font-weight: 700; color: var(--color-text-1); }
.d-desc { margin-top: 18rpx; font-size: 28rpx; color: var(--color-text-2); line-height: 1.7; }
.d-meta { margin-top: 20rpx; font-size: 24rpx; color: var(--color-text-3); }
/* display:block 是必需的：现在它是 <text user-select>，行内元素下 word-break 不生效 */
.d-link { display: block; font-size: 26rpx; color: var(--color-text-2); line-height: 1.6; word-break: break-all; margin-top: 8rpx; }
.link-tags { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; flex-wrap: wrap; }
.link-bad { font-size: 22rpx; color: var(--color-danger); }

.status-pill {
  display: inline-block; margin-top: 20rpx; padding: 6rpx 20rpx;
  border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
  background: var(--color-surface-2); color: var(--color-text-2);
}
.status-pill.on { background: var(--color-primary-soft); color: var(--color-primary-deep); }

.desc-block { margin-top: 24rpx; }
.blk-label { font-size: 24rpx; color: var(--color-text-3); margin-bottom: 8rpx; }
.desc { font-size: 28rpx; color: var(--color-text-1); line-height: 1.7; white-space: pre-wrap; }
.meta-line { font-size: 22rpx; color: var(--color-text-3); margin-top: 24rpx; }
.src-tag {
  display: inline-block; margin-top: 12rpx; padding: 4rpx 16rpx;
  font-size: 22rpx; color: var(--color-primary-deep); background: var(--color-primary-soft); border-radius: 999rpx;
}

.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo { width: 160rpx; height: 160rpx; border-radius: 16rpx; overflow: hidden; background: var(--color-surface-2); }
.photo-img { width: 100%; height: 100%; }

.btn-disabled { background: var(--color-surface-2) !important; color: var(--color-text-3) !important; }

.actions { margin-top: 28rpx; display: flex; flex-direction: column; gap: 18rpx; }
