/* pages/materials/bulkin.wxss */
.page-wrap { padding: 24rpx; }
.space-bar { margin-bottom: 20rpx; }
.space-name { font-size: 34rpx; font-weight: 600; color: var(--color-text-1); }
.tip-card { padding: 22rpx 24rpx; margin-bottom: 20rpx; background: var(--color-primary-soft); }
.search-bar { margin-bottom: 20rpx; }
.search-input { background: var(--color-surface-2); border-radius: var(--radius-pill); height: 64rpx; line-height: 64rpx; padding: 0 28rpx; font-size: 28rpx; color: var(--color-text-1); }

.bulk-row { display: flex; align-items: center; background: var(--color-surface); border-radius: var(--radius-card); padding: 22rpx 24rpx; margin-bottom: 16rpx; box-shadow: var(--shadow-card); }
.bulk-main { flex: 1; min-width: 0; }
.bulk-name { font-size: 30rpx; font-weight: 600; color: var(--color-text-1); }
.bulk-sub { font-size: 22rpx; color: var(--color-text-3); margin-top: 6rpx; }
.bulk-inputs { flex: none; display: flex; flex-direction: column; gap: 12rpx; }
.bulk-field { display: flex; align-items: center; justify-content: flex-end; }
.bulk-input { width: 140rpx; background: var(--color-surface-2); border-radius: var(--radius-inner); min-height: 56rpx; line-height: 36rpx; padding: 10rpx 16rpx; font-size: 26rpx; text-align: right; color: var(--color-text-1); }
.bulk-unit { font-size: 22rpx; color: var(--color-text-2); margin-left: 10rpx; width: 34rpx; }
