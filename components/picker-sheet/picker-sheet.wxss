.ps-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.ps-sheet {
  background: var(--color-surface);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  /* V141：底部留白同样避开底部导航栏（--tabbar-h；非 tab 页为 0 ⇒ 零视觉变化）。
     本组件当前只用在非 tab 页，但它是通用件 —— 哪天被 tab 页用上，这里不该再翻一次车。 */
  padding: var(--space-md) var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom) + var(--tabbar-h, 0px));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.ps-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
  text-align: center;
  margin-bottom: var(--space-md);
}

.ps-list {
  max-height: 50vh;
  margin-bottom: var(--space-md);
}

.ps-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md);
  margin-bottom: var(--space-xs);
  border-radius: var(--radius-inner);
  background: var(--color-surface-2);
  color: var(--color-text-1);
  font-size: 30rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.ps-option.on {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 600;
}

.ps-option-text {
  flex: 1;
  text-align: center;
}

.ps-option-check {
  flex: none;
  margin-left: var(--space-sm);
  font-size: 28rpx;
}

.ps-actions {
  display: flex;
  gap: var(--space-sm);
}

.ps-btn {
  flex: 1;
  min-width: 0;
  height: var(--btn-h);
  line-height: var(--btn-h);
  border-radius: var(--radius-inner);
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.ps-btn-ghost {
  background: var(--color-surface-2);
  color: var(--color-text-1);
}

.ps-btn-primary {
  background: var(--color-primary);
  color: var(--color-primary-on);
}
