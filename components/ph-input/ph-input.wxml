<view class="ph-input {{tall ? 'ph-tall' : ''}} {{bubble ? 'ph-has-bubble' : ''}}">
  <!-- 悬浮气泡标签：聚焦或有内容时上浮，失焦且为空时收回框内 -->
  <text wx:if="{{bubble}}" class="ph-bubble {{(focused || value) ? 'on' : ''}} {{placeholder ? 'ph-bubble-ghost' : ''}}">{{bubble}}</text>
  <textarea wx:if="{{multiline}}"
    class="ph-control ph-ta {{size ? 'ph-sz-' + size : ''}} {{phClass}}"
    value="{{value}}"
    selection-start="{{selStart}}"
    selection-end="{{selEnd}}"
    type="{{type}}"
    placeholder="{{focused ? '' : placeholder}}"
    placeholder-class="ph-ph {{size ? 'ph-ph-' + size : ''}}"
    maxlength="{{maxlength}}"
    disabled="{{disabled}}"
    auto-height="{{autoHeight}}"
    adjust-position="{{adjustPosition}}"
    cursor-spacing="{{cursorSpacing}}"
    focus="{{autofocus || focus}}"
    confirm-type="{{confirmType}}"
    bindfocus="onFocus"
    bindblur="onBlur"
    bindinput="onInput"
    bindconfirm="onConfirm"
    bindlinechange="onLineChange"
  ></textarea>
  <input wx:else
    class="ph-control ph-ip {{size ? 'ph-sz-' + size : ''}} {{phClass}}"
    value="{{value}}"
    selection-start="{{selStart}}"
    selection-end="{{selEnd}}"
    type="{{type}}"
    placeholder="{{focused ? '' : placeholder}}"
    placeholder-class="ph-ph {{size ? 'ph-ph-' + size : ''}}"
    maxlength="{{maxlength}}"
    disabled="{{disabled}}"
    focus="{{autofocus || focus}}"
    confirm-type="{{confirmType}}"
    adjust-position="{{adjustPosition}}"
    cursor-spacing="{{cursorSpacing}}"
    bindfocus="onFocus"
    bindblur="onBlur"
    bindinput="onInput"
    bindconfirm="onConfirm"
  />
</view>
